{% extends "base.njk" %}
{% import "macros/posts.njk" as postMacros %}

{% block content %}
  <!-- Main Content-->
  <div class="container px-4 px-lg-5">
    <div class="row gx-4 gx-lg-5 justify-content-center">
      <div class="col-md-10 col-lg-8 col-xl-7">
        <!-- Post preview-->
        {% for postPreview in posts %}
          {{ postMacros.postPreview(postPreview.title, postPreview.subtitle, postPreview.createdAt , loop.index0) }}
          <!-- Divider-->
          <hr class="my-4" />
        {% else %}
          <p>No post scheduled.</p>
        {% endfor %}

        <!-- Pager-->
        <div class="d-flex justify-content-end mb-4">
          <a class="btn btn-primary text-uppercase" href="#!">Older Posts →</a>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
