{% macro postPreview(title, subtitle, date, slug) %}
  <div class="post-preview">
    <a href="post/{{ slug }}">
      <h2 class="post-title">{{ title }}</h2>
      <h3 class="post-subtitle">{{ subtitle }}</h3>
    </a>
    <p class="post-meta">
      Posted by
      <a href="#!">{{ author }}</a>
      on {{ date  | date }}
    </p>
  </div>
{% endmacro %}
